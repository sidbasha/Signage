<Project>
  <!--
    Framework-dependent folder publish for deploying without Docker (matches docs/09-deployment.md, section 9.7).
    Usage:
      cd backend
      dotnet publish src/SignageCms.Api -p:PublishProfile=FolderProfile -c Release
    Output goes to backend/src/SignageCms.Api/bin/Release/net8.0/publish/.
    Requires the ASP.NET Core 8.0 runtime on the target machine (dotnet list-runtimes).
    Copy the publish folder to the server, set Jwt__SigningKey / ConnectionStrings__Default / etc.
    as environment variables (see section 9.3), and run: dotnet SignageCms.Api.dll
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <PublishDir>bin\Release\net8.0\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier />
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
